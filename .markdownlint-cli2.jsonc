{
  // 日本語ドキュメント向けに緩めた設定。構造的な壊れ（見出し階層・リンク記法など)のみ検出する。
  "config": {
    "default": true,
    "MD013": false, // 行長制限なし（日本語長文）
    "MD033": false, // インライン HTML 許可（テーブル内 <br> など）
    "MD024": { "siblings_only": true }, // 見出し重複は同階層のみ禁止
    "MD041": false, // 先頭が h1 でなくてもよい（引用ブロック開始を許可）
    "MD036": false, // 強調を見出し代わりに使うのを許可
    "MD060": false // テーブルのパイプ前後スペースは強制しない
  }
}
