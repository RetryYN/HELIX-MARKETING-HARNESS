{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prospective requirement discovery event ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "lifecycle_status",
    "coverage_start_commit",
    "historical_policy",
    "events"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "helix-requirement-discovery-events.v1", "description": "導入後は親 ledger と同値固定"},
    "authority": {"type": "string", "const": "canonical", "description": "導入後は親 ledger と同値固定"},
    "lifecycle_status": {"type": "string", "enum": ["adapted"], "description": "導入後は親 ledger と同値固定"},
    "coverage_start_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "description": "導入後は親 ledger と同値固定。前方付替え禁止"},
    "historical_policy": {"type": "string", "const": "preexisting-not-backfilled", "description": "導入後は親 ledger と同値固定"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id", "sequence", "subject_id", "event_type", "occurred_at",
          "recorded_at", "actor_principal", "references", "payload"
        ],
        "properties": {
          "event_id": {"type": "string", "pattern": "^RDE-[0-9]{6,}$"},
          "sequence": {"type": "integer", "minimum": 1},
          "subject_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,80}$"},
          "event_type": {
            "type": "string",
            "enum": [
              "candidate_recorded", "question_raised", "question_answered",
              "prototype_recorded", "observation_recorded", "specification_proposed",
              "approval_requested", "approval_decided", "policy_ratification_decided",
              "authority_classification_decided", "authority_cutover_decided", "withdrawn"
            ]
          },
          "occurred_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "actor_principal": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,80}$"},
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "id"],
              "properties": {
                "kind": {"type": "string", "enum": ["event", "source", "artifact"]},
                "id": {"type": "string", "minLength": 3, "maxLength": 160}
              }
            }
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "problem_statement": {"type": "string", "minLength": 1},
              "value_hypothesis": {"type": "string", "minLength": 1},
              "unresolved_questions": {"type": "array", "items": {"type": "string"}},
              "semantic_dimensions": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "business_actors", "beneficiaries", "workflow", "scope_in", "scope_out",
                  "constraints", "prohibitions", "human_judgement", "external_side_effects",
                  "completion_evidence", "target_phase", "unknown_dimensions"
                ],
                "properties": {
                  "business_actors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "beneficiaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "workflow": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "scope_in": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "scope_out": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "prohibitions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "human_judgement": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "external_side_effects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "completion_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "target_phase": {"type": "string", "enum": ["requirements", "prototype", "design", "implementation", "unknown"]},
                  "unknown_dimensions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["dimension", "question"],
                      "properties": {
                        "dimension": {"type": "string", "minLength": 1},
                        "question": {"type": "string", "minLength": 1}
                      }
                    }
                  }
                }
              },
              "question": {"type": "string", "minLength": 1},
              "dimension": {"type": "string", "minLength": 1},
              "question_event_id": {"type": "string", "minLength": 3},
              "answer": {"type": "string", "minLength": 1},
              "prototype_ref": {"type": "string", "minLength": 1},
              "flows": {"type": "array", "items": {"type": "string"}},
              "observation": {"type": "string", "minLength": 1},
              "evidence_ref": {"type": "string", "minLength": 1},
              "proposal_summary": {"type": "string", "minLength": 1},
              "target_artifact_ids": {"type": "array", "items": {"type": "string"}},
              "canonical_contract_mutation": {"type": "boolean"},
              "proposal_event_id": {"type": "string", "pattern": "^RDE-[0-9]{6,}$"},
              "requested_by": {"type": "string", "minLength": 1},
              "proposal_author_principal": {"type": "string", "minLength": 1},
              "approver_principal": {"type": "string", "minLength": 1},
              "decision": {"type": "string", "enum": ["accepted", "rejected"]},
              "approved_policy_id": {"type": "string", "minLength": 3},
              "approved_revision": {"type": "integer", "minimum": 1},
              "approved_policy_semantic_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "approved_rows_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "approved_candidate_content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "approved_parent_receipts_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "target_commit": {"type": "string", "minLength": 1},
              "production_write_authorized": {"type": "boolean"},
              "artifact_id": {"type": "string", "minLength": 3},
              "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
              "artifact_snapshot": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["artifact_commit", "canonical_path", "artifact_digest", "manifest_approval_digest", "receipt_digest"],
                "properties": {
                  "artifact_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                  "canonical_path": {"type": "string", "minLength": 5},
                  "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
                  "manifest_approval_digest": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
                  "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{12}$"}
                }
              },
              "reason": {"type": "string", "minLength": 1},
              "withdrawn_event_id": {"type": "string", "minLength": 3}
            }
          }
        }
      }
    }
  }
}
