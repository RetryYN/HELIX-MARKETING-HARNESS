{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prospective requirement discovery event ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "lifecycle_status",
    "coverage_start_commit",
    "historical_policy",
    "events"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "helix-requirement-discovery-events.v1"},
    "authority": {"type": "string", "const": "canonical"},
    "lifecycle_status": {"type": "string", "enum": ["adapted"]},
    "coverage_start_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "historical_policy": {"type": "string", "const": "preexisting-not-backfilled"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id", "sequence", "subject_id", "event_type", "occurred_at",
          "recorded_at", "actor_principal", "references", "payload"
        ],
        "properties": {
          "event_id": {"type": "string", "pattern": "^RDE-[0-9]{6,}$"},
          "sequence": {"type": "integer", "minimum": 1},
          "subject_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,80}$"},
          "event_type": {
            "type": "string",
            "enum": [
              "candidate_recorded", "question_raised", "question_answered",
              "prototype_recorded", "observation_recorded", "specification_proposed",
              "approval_requested", "approval_decided", "withdrawn"
            ]
          },
          "occurred_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "actor_principal": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,80}$"},
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "id"],
              "properties": {
                "kind": {"type": "string", "enum": ["event", "source", "artifact"]},
                "id": {"type": "string", "minLength": 3, "maxLength": 160}
              }
            }
          },
          "payload": {"type": "object"}
        }
      }
    }
  }
}
