{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketing-harness.local/schemas/requirement-refinement.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "decision_response_contract", "question_classifications", "decision_class_contracts", "question_boundary", "captured_po_decisions", "legacy_l0_clause_dispositions", "legacy_critical_responsibility_dispositions", "semantic_descent_policy", "legacy_nfr_dispositions", "legacy_orphan_requirement_groups", "legacy_req_disposition_groups", "legacy_br_disposition_groups", "legacy_media_br_dispositions", "legacy_fr_disposition_groups", "legacy_derived_contract_policy", "authority_revision_candidate", "objective_completion_audit", "scope_assignments", "candidate_requirement_bindings", "decision_packets", "records"],
  "properties": {
    "schema_version": {"const": "marketing-harness-requirements-refinement.v1"},
    "authority": {"const": "canonical"},
    "decision_response_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_responses", "unanswered_default", "required_bindings", "approval_effect", "revision_effect"],
      "properties": {
        "allowed_responses": {
          "const": ["approve_as_written", "revise", "defer", "reject"]
        },
        "unanswered_default": {"const": "defer"},
        "required_bindings": {
          "const": ["refinement_id", "revision", "semantic_digest", "question_id", "response", "rationale", "approver_principal", "decided_at"]
        },
        "approval_effect": {"type": "string", "minLength": 1},
        "revision_effect": {"type": "string", "minLength": 1}
      }
    },
    "question_classifications": {
      "type": "object",
      "propertyNames": {"pattern": "^RDQ-[A-Z0-9-]+-[0-9]{2}$"},
      "additionalProperties": {"enum": ["requirements_policy", "authority_choice", "safety_policy", "quality_target", "release_scope", "deferred_resume"]}
    },
    "decision_class_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements_policy", "authority_choice", "safety_policy", "quality_target", "release_scope", "deferred_resume"],
      "properties": {
        "requirements_policy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authority_choice": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "safety_policy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "quality_target": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "release_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "deferred_resume": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "question_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["po_decides", "design_later", "rule"],
      "properties": {
        "po_decides": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "design_later": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "captured_po_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "status", "statement", "affected_subject_ids", "required_new_subject_ids", "requirements_effect", "unresolved", "design_not_started", "evidence_ref"],
        "properties": {
          "decision_id": {"type": "string", "pattern": "^POD-[0-9]{8}-[0-9]{3}$"},
          "status": {"const": "captured_unratified"},
          "statement": {"type": "string", "minLength": 1},
          "affected_subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "required_new_subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "requirements_effect": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "design_not_started": {"const": true},
          "evidence_ref": {"type": "string", "pattern": "^conversation:po:"}
        }
      }
    },
    "legacy_l0_clause_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clause_id", "source_ref", "meaning", "disposition", "retained_value", "replacement_prc_ids", "resume_conditions", "status", "design_not_started"],
        "properties": {
          "clause_id": {"type": "string", "pattern": "^L0V04-[A-Z0-9-]+$"},
          "source_ref": {"type": "string", "pattern": "^marketing-harness-charter_v0\\.4 §"},
          "meaning": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["retain", "replace", "defer"]},
          "retained_value": {"type": "string", "minLength": 1},
          "replacement_prc_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^PRC-[0-9]{2}$"}},
          "resume_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "status": {"const": "candidate_unratified"},
          "design_not_started": {"const": true}
        }
      }
    },
    "legacy_critical_responsibility_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["legacy_id", "source_ref", "legacy_meaning", "disposition", "retained_responsibility", "replacement_responsibilities", "owner_subject_ids", "prohibited_inheritance", "status", "design_not_started"],
        "properties": {
          "legacy_id": {"type": "string", "pattern": "^(BR|FR)-[A-Z0-9-]+$"},
          "source_ref": {"type": "string", "minLength": 1},
          "legacy_meaning": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["retain", "replace", "split", "defer"]},
          "retained_responsibility": {"type": "string", "minLength": 1},
          "replacement_responsibilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "owner_subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "prohibited_inheritance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "status": {"const": "candidate_unratified"},
          "design_not_started": {"const": true}
        }
      }
    },
    "semantic_descent_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "design_not_started", "unknown_default", "inheritance_binding_required", "dimensions", "edge_contracts"],
      "properties": {
        "status": {"const": "candidate_unratified"},
        "design_not_started": {"const": true},
        "unknown_default": {"const": "question_then_deferred"},
        "inheritance_binding_required": {
          "const": ["source_kind", "source_stable_id", "source_revision", "source_semantic_digest", "dimension", "scope_transform", "rationale"]
        },
        "dimensions": {
          "type": "object",
          "propertyNames": {"enum": ["actors", "beneficiaries", "value", "tasks", "workflow", "scope_in", "scope_out", "prohibitions", "human_judgement", "side_effects", "evidence", "phase"]},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "rule"],
            "properties": {
              "mode": {"enum": ["direct_required", "explicit_inheritance_or_direct", "inherit_plus_local"]},
              "rule": {"type": "string", "minLength": 1}
            }
          }
        },
        "edge_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["edge_id", "source_kinds", "target_kind", "required_dimensions", "rule", "admission"],
            "properties": {
              "edge_id": {"type": "string", "pattern": "^SED-[A-Z0-9-]+$"},
              "source_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["BR", "BRM", "REQ", "FR", "SR", "NFR", "MR", "FN", "AC", "TC", "CMP", "DU"]}},
              "target_kind": {"enum": ["REQ", "FR", "SR", "NFR", "MR", "FN", "AC", "TC", "CMP", "DU"]},
              "required_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "rule": {"type": "string", "minLength": 1},
              "admission": {"enum": ["requirements_candidate", "blocked_until_frozen_requirements"]}
            }
          }
        }
      }
    },
    "legacy_nfr_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nfr_id", "disposition", "stable_br_refs", "stable_req_refs", "business_value", "actors", "scope", "replacement_meaning", "missing_decisions", "resume_conditions", "owner_subject_ids", "status", "design_not_started"],
        "properties": {
          "nfr_id": {"type": "string", "pattern": "^NFR-[0-9]+$"},
          "disposition": {"enum": ["redescent", "replace", "defer"]},
          "stable_br_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^BR-[A-Z0-9-]+$"}},
          "stable_req_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REQ-[0-9]+$"}},
          "business_value": {"type": "string", "minLength": 1},
          "actors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "replacement_meaning": {"type": "string", "minLength": 1},
          "missing_decisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "resume_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "owner_subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "status": {"const": "candidate_unratified"},
          "design_not_started": {"const": true}
        }
      }
    },
    "legacy_orphan_requirement_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "stable_ids", "disposition", "legacy_problem", "retained_value", "replacement_meaning", "stable_root_action", "descent_action", "owner_subject_ids", "resume_conditions", "status", "design_not_started"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^ORG-[A-Z0-9-]+$"},
          "stable_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(FR|SR)-[0-9]+$"}},
          "disposition": {"enum": ["redescent", "replace", "defer"]},
          "legacy_problem": {"type": "string", "minLength": 1},
          "retained_value": {"type": "string", "minLength": 1},
          "replacement_meaning": {"type": "string", "minLength": 1},
          "stable_root_action": {"type": "string", "minLength": 1},
          "descent_action": {"type": "string", "minLength": 1},
          "owner_subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "resume_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "status": {"const": "candidate_unratified"},
          "design_not_started": {"const": true}
        }
      }
    },
    "legacy_req_disposition_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "stable_ids", "item_dispositions", "legacy_problem", "replacement_policy", "stable_root_action", "owner_subject_ids", "deferred_resume_by_id", "status", "design_not_started"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^REQG-[A-Z0-9-]+$"},
          "stable_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^REQ-[0-9]{3}$"}},
          "item_dispositions": {
            "type": "object",
            "propertyNames": {"pattern": "^REQ-[0-9]{3}$"},
            "additionalProperties": {"enum": ["redescent", "replace", "defer"]}
          },
          "legacy_problem": {"type": "string", "minLength": 1},
          "replacement_policy": {"type": "string", "minLength": 1},
          "stable_root_action": {"type": "string", "minLength": 1},
          "owner_subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "deferred_resume_by_id": {
            "type": "object",
            "propertyNames": {"pattern": "^REQ-[0-9]{3}$"},
            "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "status": {"const": "candidate_unratified"},
          "design_not_started": {"const": true}
        }
      }
    },
    "legacy_br_disposition_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "stable_ids", "item_dispositions", "retained_value", "replacement_policy", "owner_subject_ids", "status", "design_not_started"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^BRG-[A-Z]$"},
          "stable_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^BR-[A-Z][0-9]+$"}},
          "item_dispositions": {"type": "object", "propertyNames": {"pattern": "^BR-[A-Z][0-9]+$"}, "additionalProperties": {"enum": ["redescent", "replace", "defer"]}},
          "retained_value": {"type": "string", "minLength": 1},
          "replacement_policy": {"type": "string", "minLength": 1},
          "owner_subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "status": {"const": "candidate_unratified"},
          "design_not_started": {"const": true}
        }
      }
    },
    "legacy_media_br_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["media_id", "stable_ids", "disposition", "current_role", "route_policy", "resume_conditions", "owner_subject_ids", "status", "design_not_started"],
        "properties": {
          "media_id": {"type": "string", "pattern": "^[a-z0-9]+$"},
          "stable_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^BR-M-[A-Z0-9-]+$"}},
          "disposition": {"enum": ["replace", "defer"]},
          "current_role": {"type": "string", "minLength": 1},
          "route_policy": {"type": "string", "minLength": 1},
          "resume_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "owner_subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "status": {"const": "candidate_unratified"},
          "design_not_started": {"const": true}
        }
      }
    },
    "legacy_fr_disposition_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "stable_ids", "item_dispositions", "replacement_policy", "owner_subject_ids", "deferred_resume_by_id", "status", "design_not_started"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^FRG-[A-Z0-9-]+$"},
          "stable_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FR-[0-9]+$"}},
          "item_dispositions": {"type": "object", "propertyNames": {"pattern": "^FR-[0-9]+$"}, "additionalProperties": {"enum": ["redescent", "replace", "defer"]}},
          "replacement_policy": {"type": "string", "minLength": 1},
          "owner_subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "deferred_resume_by_id": {"type": "object", "propertyNames": {"pattern": "^FR-[0-9]+$"}, "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
          "status": {"const": "candidate_unratified"},
          "design_not_started": {"const": true}
        }
      }
    },
    "legacy_derived_contract_policy": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "stable_id_count", "stable_id_digest", "disposition", "parent_requirement_kinds", "reuse_requirements", "prohibited_claims", "status", "design_not_started"],
        "properties": {
          "kind": {"enum": ["FN", "AC", "TC"]},
          "stable_id_count": {"type": "integer", "minimum": 1},
          "stable_id_digest": {"$ref": "#/$defs/digest"},
          "disposition": {"const": "defer_until_parent_redescent"},
          "parent_requirement_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["FR", "SR", "NFR", "MR"]}},
          "reuse_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "prohibited_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "status": {"const": "legacy_revalidation_only"},
          "design_not_started": {"const": true}
        }
      }
    },
    "authority_revision_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "question", "recommended_strategy", "alternatives", "recommended_rules", "legacy_consumer_action", "po_decision", "status", "design_not_started"],
      "properties": {
        "decision_id": {"const": "AUTHORITY-REVISION-STRATEGY"},
        "question": {"type": "string", "minLength": 1},
        "recommended_strategy": {"const": "new_revision_single_json_authority"},
        "alternatives": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["new_revision_single_json_authority", "rewrite_legacy_ids_in_place"]}},
        "recommended_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "legacy_consumer_action": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "po_decision": {"type": "null"},
        "status": {"const": "pending_po"},
        "design_not_started": {"const": true}
      }
    },
    "objective_completion_audit": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objective_id", "requirement", "status", "evidence", "remaining_condition"],
        "properties": {
          "objective_id": {"type": "string", "pattern": "^OBJ-[0-9]{2}$"},
          "requirement": {"type": "string", "minLength": 1},
          "status": {"enum": ["proven", "incomplete", "blocked_by_po"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "remaining_condition": {"type": ["string", "null"]}
        }
      }
    },
    "scope_assignments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"enum": ["requirements_governance", "initial_candidate", "follow_on_candidate", "deferred_candidate"]}
    },
    "candidate_requirement_bindings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^PRC-[0-9]{2}$"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "decision_packets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packet_id", "decision_order", "subject_ids", "decision_question", "bulk_decision_forbidden"],
        "properties": {
          "packet_id": {"type": "string", "pattern": "^RDP-[A-Z0-9-]+$"},
          "decision_order": {"type": "integer", "minimum": 1},
          "subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "decision_question": {"type": "string", "minLength": 1},
          "bulk_decision_forbidden": {"const": true}
        }
      }
    },
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/refinement"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semanticDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actors", "beneficiaries", "value", "tasks", "workflow", "scope_in", "scope_out", "prohibitions", "human_judgement", "side_effects", "evidence", "phase"],
      "properties": {
        "actors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "beneficiaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "value": {"type": "string", "minLength": 1},
        "tasks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "workflow": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "scope_in": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "scope_out": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "prohibitions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "human_judgement": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "side_effects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "phase": {"type": "string", "minLength": 1}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_id", "polarity", "statement", "system_test_id"],
      "properties": {
        "acceptance_id": {"type": "string", "pattern": "^RAC-[A-Z0-9-]+$"},
        "polarity": {"enum": ["positive", "negative", "boundary"]},
        "statement": {"type": "string", "minLength": 1},
        "system_test_id": {"type": "string", "pattern": "^RST-[A-Z0-9-]+$"}
      }
    },
    "refinement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refinement_id", "subject_id", "revision", "lifecycle_status", "source_event_ids", "source_set_digest", "semantic_dimensions", "acceptance_cases", "pending_resolution", "semantic_digest", "approval"],
      "properties": {
        "refinement_id": {"type": "string", "pattern": "^RRF-[A-Z0-9-]+$"},
        "subject_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "lifecycle_status": {"enum": ["draft", "specified", "approved", "frozen", "rejected", "superseded"]},
        "source_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^RDE-[0-9]{6}$"}},
        "source_set_digest": {"$ref": "#/$defs/digest"},
        "semantic_dimensions": {"$ref": "#/$defs/semanticDimensions"},
        "delivery_admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["standard_model", "increment_routes", "discovery_condition", "predecessor_subject_ids", "program_stage", "sequence", "completion_boundary"],
          "properties": {
            "standard_model": {"const": "full_v_l1_l12"},
            "increment_routes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["production_scrum", "v_design_scrum_impl_hybrid", "none"]}},
            "discovery_condition": {"const": "only_when_feasibility_or_success_condition_unknown"},
            "predecessor_subject_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "program_stage": {"type": "integer", "minimum": 1},
            "sequence": {"type": "integer", "minimum": 1},
            "completion_boundary": {"const": "po_s4_then_scrum_reverse_sr0_sr4_and_v_pair_closure"}
          }
        },
        "legacy_media_admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["covered_legacy_mr_ids", "default_status", "unresolved_fields", "reason", "resume_conditions"],
          "properties": {
            "covered_legacy_mr_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^MR-[A-Z0-9-]+$"}},
            "default_status": {"const": "deferred"},
            "unresolved_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["business_value", "execution_mode", "principal", "effect", "policy_category", "credential_scope", "quota", "evidence", "acceptance_trace"]}},
            "reason": {"type": "string", "minLength": 1},
            "resume_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "acceptance_cases": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/acceptance"}},
        "pending_resolution": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "semantic_digest": {"$ref": "#/$defs/digest"},
        "approval": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["authority", "approver_principal", "subject_digest", "source_set_digest", "decision_receipt_digest", "approved_revision", "approved_at"],
              "properties": {
                "authority": {"const": "PO"},
                "approver_principal": {"type": "string", "minLength": 1},
                "subject_digest": {"$ref": "#/$defs/digest"},
                "source_set_digest": {"$ref": "#/$defs/digest"},
                "decision_receipt_digest": {"$ref": "#/$defs/digest"},
                "approved_revision": {"type": "integer", "minimum": 1},
                "approved_at": {"type": "string", "format": "date-time"}
              }
            }
          ]
        }
      }
    }
  }
}
