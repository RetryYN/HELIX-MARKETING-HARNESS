{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HELIX-HARNESS template alignment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "source", "adoption", "mappings", "gaps", "required_checks"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["helix-harness-alignment.v1"]},
    "authority": {"type": "string", "enum": ["canonical"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "url", "commit", "latest_checked_commit", "latest_checked_at", "delta_disposition", "read_only"],
      "properties": {
        "repository": {"type": "string", "enum": ["RetryYN/HELIX-HARNESS"]},
        "url": {"type": "string", "minLength": 20},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "latest_checked_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "latest_checked_at": {"type": "string", "format": "date"},
        "delta_disposition": {"type": "string", "enum": ["non-applicable", "partially-adapted", "adopted"]},
        "read_only": {"type": "boolean", "enum": [true]}
      }
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "runtime", "bun_active_dependency", "product_runtime_dependency", "current_layer_model", "template_layer_model", "requirements_scope"],
      "properties": {
        "mode": {"type": "string", "enum": ["methodology-and-development-environment"]},
        "runtime": {"type": "string", "enum": ["python-native"]},
        "bun_active_dependency": {"type": "boolean", "enum": [false]},
        "product_runtime_dependency": {"type": "string", "enum": ["none"]},
        "current_layer_model": {"type": "string", "enum": ["L0-L6"]},
        "template_layer_model": {"type": "string", "enum": ["L0-L14"]},
        "requirements_scope": {"type": "string", "enum": ["requirements-definition-through-L3-and-L2-prototype"]}
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "template_paths", "current_paths", "status", "rationale"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "template_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "current_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["adopted", "adapted", "bridge", "deferred"]},
          "rationale": {"type": "string", "minLength": 10}
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "status": {"type": "string", "enum": ["deferred", "not-applicable"]},
          "reason": {"type": "string", "minLength": 10}
        }
      }
    },
    "required_checks": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 3}}
  }
}
