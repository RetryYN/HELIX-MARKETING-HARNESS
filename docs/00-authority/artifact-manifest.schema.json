{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "artifact-manifest",
  "description": "全現役成果物の権威正本。1 artifact ID につき active な canonical は 1 件のみ。canonical=正本／view=生成ビューを authority_format・view_generation で、現役位置と内容成熟度を authority_status・lifecycle_status で、置換（supersedes）と拡張（extends_artifact_ids）／依存（depends_on_artifact_ids）を別フィールドで分離する。G-AUTHORITY-MANIFEST 系が fail-close 検査する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "authority",
    "updated",
    "note",
    "applicability_policy",
    "items"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": [
        "active"
      ]
    },
    "authority": {
      "type": "string",
      "minLength": 2
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "note": {
      "type": "string",
      "minLength": 10
    },
    "applicability_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements_baseline_status", "current_layers", "revalidation_required_layers", "implementation_input", "exception_artifact_ids", "layer_policy_is_default", "per_artifact_applicability_required"],
      "properties": {
        "requirements_baseline_status": {"const": "revising"},
        "current_layers": {"const": ["00-authority"]},
        "revalidation_required_layers": {"const": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"]},
        "implementation_input": {"const": false},
        "exception_artifact_ids": {"const": []},
        "layer_policy_is_default": {"const": true},
        "per_artifact_applicability_required": {"const": true}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "layer",
          "slice",
          "domain",
          "artifact_type",
          "authority_format",
          "authority_status",
          "lifecycle_status",
          "applicability_status",
          "implementation_input",
          "canonical_path",
          "view_path",
          "view_generation",
          "pair_artifact_id",
          "supersedes",
          "extends_artifact_ids",
          "depends_on_artifact_ids",
          "previous_paths",
          "approval_digest",
          "review_digest"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$"
          },
          "layer": {
            "type": "string",
            "enum": [
              "00-authority",
              "L0",
              "L1",
              "L2",
              "L3",
              "L4",
              "L5",
              "L6"
            ]
          },
          "slice": {
            "type": "string",
            "enum": [
              "S0",
              "S1",
              "later",
              "cross"
            ]
          },
          "domain": {
            "type": "string",
            "minLength": 2
          },
          "artifact_type": {
            "type": "string",
            "enum": [
              "charter",
              "policy",
              "adr",
              "audit-record",
              "requirement-doc",
              "requirement-contract",
              "requirement-ledger",
              "schema",
              "fixture",
              "ddl",
              "design-doc",
              "design-contract",
              "design-ledger",
              "module-contract",
              "test-design",
              "test-ledger",
              "plan",
              "catalog"
            ]
          },
          "authority_format": {
            "type": "string",
            "enum": [
              "json",
              "sql",
              "markdown"
            ],
            "description": "正本の形式。機械実装入力・台帳・schema・DDL は json/sql、人間承認そのものが正本の文書のみ markdown。"
          },
          "authority_status": {
            "type": "string",
            "enum": [
              "active",
              "superseded",
              "archived"
            ],
            "description": "現役導線上の位置だけを表す（内容成熟度は表さない）。"
          },
          "lifecycle_status": {
            "type": "string",
            "enum": [
              "draft",
              "confirmed",
              "planned",
              "in_progress",
              "completed"
            ],
            "description": "内容成熟度。confirmed は approval_digest 必須（G-STATUS-CONSISTENCY）。"
          },
          "applicability_status": {
            "type": "string",
            "enum": ["current", "proposal_only", "revalidation_required", "blocked"],
            "description": "現行baselineへの適用可否。authority_status/lifecycle_statusとは独立し、旧confirmed成果物の現行入力化を防ぐ。"
          },
          "implementation_input": {
            "type": "boolean",
            "description": "当該成果物を製品設計・実装入力として使用できる場合だけtrue。requirements revising中は全件false。"
          },
          "canonical_path": {
            "type": "string",
            "minLength": 5
          },
          "view_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "view_generation": {
            "type": "string",
            "enum": [
              "generated",
              "none"
            ],
            "description": "generated = view_path に生成 MD を持つ。none = 生成ビューなし。"
          },
          "pair_artifact_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "旧成果物を**完全置換**する場合だけに使う。置換先は authority_status=superseded／archived でなければならない（G-MANIFEST-RELATION）。"
          },
          "extends_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "現役の他成果物を置換せずに**拡張**する関係（例: S1 の完成文書が S0 の基盤文書を拡張する）。置換ではないので supersedes を使わない。"
          },
          "depends_on_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "実装入力として依存する現役成果物。拡張でも置換でもない参照関係を明示する。"
          },
          "previous_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approval_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{12}$"
          },
          "review_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{16}$"
          }
        }
      }
    }
  }
}
