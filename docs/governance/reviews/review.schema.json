{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review-artifact",
  "description": "独立レビュー（Sol 等）の成果物。コミットメッセージでの Go 記録を禁止し、対象コミットと成果物 digest に束縛する（クロージャー §8）。G-REVIEW-BINDING が検証する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "reviewer_principal",
    "model",
    "target_commit",
    "reviewed_artifact_digests",
    "findings",
    "resolution_commits",
    "verdict",
    "completed_at",
    "rounds"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "pattern": "^REV-[A-Z0-9-]+$"
    },
    "reviewer_principal": {
      "type": "string",
      "minLength": 3,
      "description": "レビュー主体（実装者と別 principal であること）"
    },
    "model": {
      "type": "string",
      "minLength": 3
    },
    "target_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "レビュー対象の凍結コミット（full sha）"
    },
    "reviewed_artifact_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{16}$"
      },
      "description": "レビュー時点の成果物 sha256[:16]。レビュー後の改変を G-REVIEW-BINDING が検出する"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "summary",
          "status"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 10
          },
          "status": {
            "type": "string",
            "enum": [
              "resolved",
              "accepted-as-is",
              "deferred"
            ]
          },
          "resolution": {
            "type": "string",
            "minLength": 6
          },
          "deferred_to": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "resolution_commits": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{7,40}$"
      },
      "description": "是正コミット（findings に status=resolved がある場合は 1 件以上必須 — G-REVIEW-BINDING が検査）"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "Go",
        "No-Go"
      ]
    },
    "completed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
    },
    "rounds": {
      "type": "integer",
      "minimum": 1,
      "description": "No-Go→是正→再レビューの往復回数"
    },
    "scope": {
      "type": "string",
      "minLength": 4,
      "description": "レビュー範囲（S0 設計クロージャー等）"
    }
  }
}