{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "S0.1 原子単位 索引 schema",
  "description": "docs/L6-feature-design/S0/atomic-units/index.json の構造。索引と実在する AU-*.json の集合は完全一致でなければならない（G-ATOMIC-SCHEMA）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["doc", "version", "slice", "update", "note", "derivation", "units"],
  "properties": {
    "doc": {"type": "string"},
    "version": {"type": "string"},
    "slice": {"type": "string", "enum": ["S0"]},
    "update": {"type": "string", "enum": ["S0.1"]},
    "note": {"type": "string", "minLength": 1},
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_source", "dependency_source", "attribution", "merge_policy", "workset_status"],
      "properties": {
        "api_source": {"type": "string"},
        "dependency_source": {"type": "string"},
        "attribution": {"type": "string"},
        "merge_policy": {"type": "string"},
        "workset_status": {"type": "string"}
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atomic_unit_id", "file", "workset_id"],
        "properties": {
          "atomic_unit_id": {"type": "string", "pattern": "^AU-DU[0-9]{2}-[0-9]{2}$"},
          "file": {"type": "string", "pattern": "^AU-DU[0-9]{2}-[0-9]{2}\\.json$"},
          "workset_id": {"type": "string", "pattern": "^WS-S0\\.1-[ABC]$"}
        }
      }
    }
  }
}
