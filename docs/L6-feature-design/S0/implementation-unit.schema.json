{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "implementation-unit",
  "description": "L6 機能設計の実装単位。責務を API 1 本（api_id）とその契約節（clause_id）へ構造接続し、当該節を検証する AC／TC／UT を束縛する。語彙一致・名前の部分一致を接続の根拠にしない（G-L6-IMPLEMENTATION-TRACE）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id",
    "doc",
    "du_id",
    "responsibility",
    "api_ref",
    "clause_refs",
    "ac_refs",
    "tc_refs",
    "ut_refs"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "pattern": "^IU-[A-Z0-9]+-[0-9]{2}$"
    },
    "doc": {
      "type": "string",
      "pattern": "^docs/L6-feature-design/(S0|S1|later)/[a-z0-9-]+\\.md$",
      "description": "この責務を記述する L6 機能設計文書。更新軸とslice軸を混同せず、S0/S1/laterの実配置・frontmatterへ接続し、本文にunit_idが現れること"
    },
    "du_id": {
      "type": "string",
      "pattern": "^DU-[0-9]{2}$"
    },
    "responsibility": {
      "type": "string",
      "minLength": 20,
      "description": "責務の説明（人間向け）。接続の根拠にはしない — 根拠は api_ref／clause_refs の構造参照"
    },
    "api_ref": {
      "type": "string",
      "pattern": "^API-DU[0-9]{2}-[0-9]{2}$",
      "description": "責務が実装する API の安定 ID。**1 件のみ**（配列禁止 — 1 責務 1 API）"
    },
    "clause_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^API-DU[0-9]{2}-[0-9]{2}-(PRE|POST|RAISE)-[0-9]{2}$"
      },
      "description": "この責務が実現する api_ref の契約節。ac_refs・ut_refs が同じ節を参照していなければならない"
    },
    "ac_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AC-[A-Z0-9-]+$"
      }
    },
    "tc_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^TCC?-[A-Z0-9-]+$"
      }
    },
    "ut_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^test_[a-z0-9_]+\\.py::test_[a-z0-9_]+$"
      }
    }
  }
}
