{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helix-marketing-harness/strategy/segment-context.schema.json",
  "title": "segment_context — 状況ベースのセグメント（人口統計ペルソナ禁止。時間・空間・制約・進行状態・代替行動が中心）",
  "type": "object",
  "required": [
    "id",
    "version",
    "market_model_id",
    "time_context",
    "space_context",
    "progress_state",
    "trigger_events",
    "constraints",
    "alternative_behaviors",
    "decision_conditions",
    "evidence_ids",
    "confidence",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SEG-"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "版。上書きせず新版を作る（append-only）"
    },
    "market_model_id": {
      "type": "string",
      "pattern": "^MKT-"
    },
    "time_context": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "時間文脈（いつ・どの局面に置かれているか）",
      "minItems": 1
    },
    "space_context": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "空間文脈（どこで・どの環境で）",
      "minItems": 1
    },
    "progress_state": {
      "type": "string",
      "description": "進行状態（問題解決のどの段階にいるか）",
      "minLength": 1
    },
    "trigger_events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "変化のトリガー"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "制約（利用可能な資源・時間・予算等）",
      "minItems": 1
    },
    "alternative_behaviors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "既存の代替行動",
      "minItems": 1
    },
    "decision_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "意思決定条件",
      "minItems": 1
    },
    "non_target_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "非対象条件"
    },
    "demographic_attributes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "人口統計属性（補助変数のみ。これだけで構成されたセグメントはゲートで拒否 — G-SEGMENT-CONTEXT）"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "根拠 observation / evidence ID",
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "信頼度（0.0〜1.0）。複数観測・反証の評価で更新する"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "置換した旧版の ID。上流正本の変更は supersedes_id による append-only 新バージョンのみ"
    }
  }
}
