{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helix-marketing-harness/strategy/market-model.schema.json",
  "title": "market_model — 市場の捉え方（市場分析工程の出力）",
  "type": "object",
  "required": [
    "id",
    "version",
    "name",
    "market_framing",
    "comparison_axes",
    "evidence_ids",
    "confidence",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MKT-"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "版。上書きせず新版を作る（append-only）"
    },
    "name": {
      "type": "string",
      "description": "市場モデル名",
      "minLength": 1
    },
    "market_framing": {
      "type": "string",
      "description": "何を市場と捉えるか（カテゴリー境界・代替の範囲）",
      "minLength": 8
    },
    "comparison_axes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "市場で使われている比較軸",
      "minItems": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "根拠 market_observation / evidence ID",
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "信頼度（0.0〜1.0）。複数観測・反証の評価で更新する"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "置換した旧版の ID。上流正本の変更は supersedes_id による append-only 新バージョンのみ"
    }
  }
}
