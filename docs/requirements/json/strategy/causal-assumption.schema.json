{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helix-marketing-harness/strategy/causal-assumption.schema.json",
  "title": "causal_assumption — 因果仮説（施策→認識変化→成果の想定機構）",
  "type": "object",
  "required": [
    "id",
    "version",
    "cause",
    "effect",
    "mechanism",
    "disconfirming_conditions",
    "evidence_ids",
    "confidence",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CA-"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "版。上書きせず新版を作る（append-only）"
    },
    "cause": {
      "type": "string",
      "description": "原因（施策・刺激）",
      "minLength": 1
    },
    "effect": {
      "type": "string",
      "description": "結果（期待する認識変化・行動変化）",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "description": "因果機構（なぜそうなると考えるか）",
      "minLength": 8
    },
    "disconfirming_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "反証条件",
      "minItems": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "根拠 ID",
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "信頼度（0.0〜1.0）。複数観測・反証の評価で更新する"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "置換した旧版の ID。上流正本の変更は supersedes_id による append-only 新バージョンのみ"
    }
  }
}
