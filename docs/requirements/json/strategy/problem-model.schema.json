{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helix-marketing-harness/strategy/problem-model.schema.json",
  "title": "problem_model — 問題と未充足価値",
  "type": "object",
  "required": [
    "id",
    "version",
    "segment_context_id",
    "problem_statement",
    "unmet_value",
    "salience",
    "evidence_ids",
    "confidence",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PRB-"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "版。上書きせず新版を作る（append-only）"
    },
    "segment_context_id": {
      "type": "string",
      "pattern": "^SEG-"
    },
    "problem_statement": {
      "type": "string",
      "description": "問題定義",
      "minLength": 8
    },
    "unmet_value": {
      "type": "string",
      "description": "未充足価値",
      "minLength": 1
    },
    "salience": {
      "type": "string",
      "enum": [
        "latent",
        "recognized",
        "urgent"
      ],
      "description": "問題の顕在度"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "根拠 ID",
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "信頼度（0.0〜1.0）。複数観測・反証の評価で更新する"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "置換した旧版の ID。上流正本の変更は supersedes_id による append-only 新バージョンのみ"
    }
  }
}
