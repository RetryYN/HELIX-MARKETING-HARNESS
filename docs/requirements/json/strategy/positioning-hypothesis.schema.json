{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helix-marketing-harness/strategy/positioning-hypothesis.schema.json",
  "title": "positioning_hypothesis — ポジショニング仮説",
  "type": "object",
  "required": [
    "id",
    "version",
    "category_definition_id",
    "position_statement",
    "comparison_axes",
    "differentiation_basis",
    "evidence_ids",
    "confidence",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^POS-"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "版。上書きせず新版を作る（append-only）"
    },
    "category_definition_id": {
      "type": "string",
      "pattern": "^CAT-"
    },
    "position_statement": {
      "type": "string",
      "description": "ポジショニング宣言",
      "minLength": 8
    },
    "comparison_axes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "優位を主張する比較軸",
      "minItems": 1
    },
    "differentiation_basis": {
      "type": "string",
      "description": "差別化根拠",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "根拠 ID",
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "信頼度（0.0〜1.0）。複数観測・反証の評価で更新する"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "置換した旧版の ID。上流正本の変更は supersedes_id による append-only 新バージョンのみ"
    }
  }
}
