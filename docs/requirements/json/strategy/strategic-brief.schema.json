{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helix-marketing-harness/strategy/strategic-brief.schema.json",
  "title": "strategic_brief — 上流戦略を下流戦術へ渡す唯一の契約。下流ループは有効な brief なしに開始できない",
  "type": "object",
  "required": [
    "id",
    "version",
    "strategic_choice_id",
    "segment_context_id",
    "value_hypothesis_id",
    "desired_recognition_change",
    "tactical_objective",
    "media_role",
    "message_hypothesis",
    "prohibited_patterns",
    "measurement_plan",
    "valid_from",
    "digest"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SB-"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "版。上書きせず新版を作る（append-only）"
    },
    "strategic_choice_id": {
      "type": "string",
      "pattern": "^SC-"
    },
    "segment_context_id": {
      "type": "string",
      "pattern": "^SEG-"
    },
    "value_hypothesis_id": {
      "type": "string",
      "pattern": "^VH-"
    },
    "desired_recognition_change": {
      "type": "string",
      "description": "この brief が市場に起こす認識変化",
      "minLength": 8
    },
    "tactical_objective": {
      "type": "string",
      "description": "戦術目標（下流ループが学習する範囲）",
      "minLength": 1
    },
    "media_role": {
      "type": "string",
      "description": "媒体の戦略上の役割（media-roles.json 台帳の語彙。単なる媒体名は不可）",
      "minLength": 1
    },
    "message_hypothesis": {
      "type": "string",
      "description": "メッセージ仮説",
      "minLength": 1
    },
    "prohibited_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "禁止パターン（倫理線・ブランド線）"
    },
    "measurement_plan": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "計測計画（何を観測すれば仮説を判定できるか）",
      "minItems": 1
    },
    "valid_from": {
      "type": "string",
      "description": "有効開始（ISO 8601）",
      "minLength": 8
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "description": "有効期限"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "brief 内容の sha256。下流 run はこの digest を保持し改変を検出する"
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "置換した旧版の ID。上流正本の変更は supersedes_id による append-only 新バージョンのみ"
    }
  }
}
