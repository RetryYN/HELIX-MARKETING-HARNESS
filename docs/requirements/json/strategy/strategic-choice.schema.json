{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helix-marketing-harness/strategy/strategic-choice.schema.json",
  "title": "strategic_choice — 戦略判断（選択案と棄却案の両方を保持）",
  "type": "object",
  "required": [
    "id",
    "version",
    "selected_segment_ids",
    "value_hypothesis_ids",
    "category_definition_id",
    "positioning_hypothesis_id",
    "objective",
    "time_horizon",
    "guardrails",
    "rejected_options",
    "decision_basis",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SC-"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "版。上書きせず新版を作る（append-only）"
    },
    "selected_segment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "選択したセグメント（SEG-*）",
      "minItems": 1
    },
    "value_hypothesis_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "採用した価値仮説（VH-*）",
      "minItems": 1
    },
    "category_definition_id": {
      "type": "string",
      "pattern": "^CAT-"
    },
    "positioning_hypothesis_id": {
      "type": "string",
      "pattern": "^POS-"
    },
    "objective": {
      "type": "string",
      "description": "戦略目標",
      "minLength": 8
    },
    "time_horizon": {
      "type": "string",
      "description": "時間地平",
      "minLength": 1
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ガードレール（禁止領域・上限）"
    },
    "rejected_options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "option",
          "rejection_reason"
        ],
        "properties": {
          "option": {
            "type": "string"
          },
          "rejection_reason": {
            "type": "string"
          }
        }
      },
      "description": "棄却した選択肢と棄却理由（選択案だけの保持を禁止）"
    },
    "decision_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "判断根拠（observation / TLP / evidence ID）",
      "minItems": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "retired"
      ]
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "置換した旧版の ID。上流正本の変更は supersedes_id による append-only 新バージョンのみ"
    }
  }
}
