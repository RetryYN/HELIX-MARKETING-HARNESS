{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "br-contract",
  "description": "業務要求（BR）の構造化契約。1 行要求文を禁止し、目的〜証跡〜trace の 12 観点を必須化する（全層再降下・粒度是正指示 §2）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "group", "title", "purpose", "actor", "trigger", "problem", "value", "scope_in", "scope_out", "constraints", "prohibitions", "human_judgement", "failure_impact", "completion_evidence", "trace_up", "trace_down", "mandated_groups", "fill"],
  "properties": {
    "id": {"type": "string", "pattern": "^BR-[A-Z][0-9]$"},
    "group": {"type": "string", "minLength": 2},
    "title": {"type": "string", "minLength": 4},
    "purpose": {"type": "string", "minLength": 15, "description": "目的 — この要求が達成したいこと"},
    "actor": {"type": "string", "minLength": 4, "description": "主体・利用者"},
    "trigger": {"type": "string", "minLength": 10, "description": "発生状況・トリガー"},
    "problem": {"type": "string", "minLength": 15, "description": "現在の問題（この要求がないと何が起きるか）"},
    "value": {"type": "string", "minLength": 15, "description": "期待する価値・成果"},
    "scope_in": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 4}},
    "scope_out": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 4}},
    "constraints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 6}},
    "prohibitions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 6}},
    "human_judgement": {"type": "string", "minLength": 6, "description": "人間判断点（なし = 『なし（全自動）』と明示）"},
    "failure_impact": {"type": "string", "minLength": 15, "description": "失敗時の影響"},
    "completion_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 6}, "description": "完了を証明する証跡"},
    "trace_up": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 4}, "description": "上流思想（charter §・TAKUMI 思想）への trace"},
    "trace_down": {
      "type": "object",
      "additionalProperties": false,
      "required": ["req"],
      "properties": {
        "req": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^REQ-[0-9]{3}$"}},
        "fr": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FR-[0-9]+$"}},
        "sr": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SR-[0-9]{2}$"}},
        "nfr": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^NFR-[0-9]+$"}}
      }
    },
    "mandated_groups": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["brand-isolation", "upstream-downstream-separation", "hypothesis-refutation-revision", "kpi-crossover", "multi-media-campaign", "content-value-definition", "zero-ad-spend", "ethics-line", "human-ai-boundary", "evidence-resume-idempotency", "external-ops-approval", "learning-failure-packet"]},
      "description": "指示 §2 の 12 独立要求群のうち、この BR が正本として担う群（担わない場合は空配列）"
    },
    "fill": {"type": "string", "enum": ["H", "R", "C", "—", "H+R", "R+C", "H+C"], "description": "充填経路"}
  }
}
