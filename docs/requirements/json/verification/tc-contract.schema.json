{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tc-contract",
  "description": "テストケース（TC）の検証契約。状態・副作用・証跡・外部呼出回数まで検証する（全層再降下 §5）。既存 TC-01〜59（verification.json）は履歴として保持し、本カタログが AC 検証契約 155 件との双方向接続の正本。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ac",
    "kind",
    "verifies_state",
    "verifies_db_delta",
    "verifies_evidence",
    "verifies_forbidden",
    "external_calls",
    "method",
    "slice",
    "semantic_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TCC-[A-Z0-9-]+$"
    },
    "ac": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AC(-SR)?-[0-9]+(-[0-9]+)?$"
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "normal",
        "reject",
        "boundary",
        "kill",
        "conflict",
        "resume"
      ]
    },
    "verifies_state": {
      "type": "string",
      "minLength": 4,
      "description": "assert する状態（状態機械・オブジェクト状態）"
    },
    "verifies_db_delta": {
      "type": "string",
      "minLength": 4,
      "description": "assert する DB 差分（行数・列値）"
    },
    "verifies_evidence": {
      "type": "string",
      "minLength": 2,
      "description": "assert する証跡行（なし = 『なし』）"
    },
    "verifies_forbidden": {
      "type": "string",
      "minLength": 4,
      "description": "assert する禁止副作用の不在"
    },
    "external_calls": {
      "type": "string",
      "minLength": 2,
      "description": "期待する外部呼出回数（例: '0 回'・'WP REST 1 回'。該当なし = '0 回'）"
    },
    "method": {
      "type": "string",
      "minLength": 10,
      "description": "検証手段（pytest fixture・SQL assert・例外捕捉の具体）"
    },
    "slice": {
      "type": "string",
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3+"
      ]
    },
    "semantic_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_refs",
        "column_refs",
        "state_refs",
        "event_refs",
        "evidence_kind_refs",
        "error_type_refs",
        "api_refs"
      ],
      "description": "構造化参照（G-SEMANTIC-REF/G-COLUMN-REF/G-STATE-EVIDENCE-CONSISTENCY が正本と突合）。自由文でなくこの配列が意味整合の検査対象。",
      "properties": {
        "table_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "参照テーブル（ddl.sql と突合）"
        },
        "column_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z_]+$"
          },
          "description": "<table>.<column>（ddl.sql と突合）"
        },
        "state_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z_]+$"
          },
          "description": "<entity>.<state>（transitions.json と突合）"
        },
        "event_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "遷移イベント（transitions.json と突合）"
        },
        "evidence_kind_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "evidence kind（evidence-kinds.json と突合）"
        },
        "error_type_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "エラー型（error-taxonomy と突合）"
        },
        "api_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "公開 API 名（du-contracts と突合）"
        }
      }
    }
  }
}