{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ac-contract",
  "description": "受入条件（AC）の検証契約。GWT に加え fixture・観測点・期待状態・DB 差分・証跡・禁止副作用・エラー型・対象更新を必須化する（全層再降下 §4）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "target",
    "polarity",
    "given",
    "when",
    "then",
    "fixture",
    "observation_point",
    "expected_state",
    "expected_db_delta",
    "expected_evidence",
    "forbidden_side_effects",
    "error_type",
    "target_update",
    "tc",
    "semantic_refs",
    "verifies_clause_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^AC(-SR)?-[0-9]+(-[0-9]+)?$"
    },
    "target": {
      "type": "string",
      "pattern": "^(FR-[0-9]+|SR-[0-9]{2}|NFR-[0-9]+)$"
    },
    "polarity": {
      "type": "string",
      "enum": [
        "normal",
        "reject",
        "boundary-recovery"
      ]
    },
    "verification_aspects": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^NFR-[0-9]+:[a-z0-9-]+$"},
      "description": "NFR target のときに必須。親NFRの検証意味単位を過不足なく列挙する"
    },
    "transition_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity", "from", "event", "to"],
        "properties": {
          "entity": {"type": "string", "enum": ["loop_runs", "tasks"]},
          "from": {"type": "string", "pattern": "^[a-z_]+$"},
          "event": {"type": "string", "pattern": "^[a-z_]+$"},
          "to": {"type": "string", "pattern": "^[a-z_]+$"}
        }
      },
      "description": "成立を検証する (entity, from, event, to)。transitions.json と完全照合し、親FR/SR/NFRおよび対応TCCの集合に一致させる"
    },
    "given": {
      "type": "string",
      "minLength": 10
    },
    "when": {
      "type": "string",
      "minLength": 8
    },
    "then": {
      "type": "string",
      "minLength": 10
    },
    "fixture": {
      "type": "string",
      "minLength": 6,
      "description": "前提データの具体形（fixture ファイル参照または seed 記述）"
    },
    "observation_point": {
      "type": "string",
      "minLength": 6,
      "description": "何をどこで観測するか（API 戻り値・DB クエリ・ログ行）"
    },
    "expected_state": {
      "type": "string",
      "minLength": 4,
      "description": "実行後の期待状態（状態機械の状態・オブジェクト状態）"
    },
    "expected_db_delta": {
      "type": "string",
      "minLength": 4,
      "description": "期待 DB 差分（INSERT/UPDATE される行。差分なし = 『差分なし』と明示）"
    },
    "expected_evidence": {
      "type": "string",
      "minLength": 4,
      "description": "期待証跡（evidence/operation_log の行。なし = 『なし』と明示）"
    },
    "forbidden_side_effects": {
      "type": "string",
      "minLength": 4,
      "description": "起きてはならない副作用（例: 外部呼出 0 回・brief 行の変更なし）"
    },
    "error_type": {
      "type": "string",
      "minLength": 2,
      "description": "期待エラー型（reject 系は具体的な例外/拒否種別。normal 系 = 『なし』）"
    },
    "target_update": {
      "type": "string",
      "minLength": 4,
      "description": "この AC が守る対象更新（S0.x スライス／対象 API・遷移）"
    },
    "tc": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(TC|TCC|ITC|STC-[GI]|UT)-[A-Z0-9-]+$"
      },
      "description": "対応 TC（検証設計側 — G-AC-COVERAGE が双方向検査）"
    },
    "na_note": {
      "type": "string",
      "description": "（親 FR 側で使用しない — 予約）"
    },
    "semantic_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_refs",
        "column_refs",
        "state_refs",
        "event_refs",
        "evidence_kind_refs",
        "error_type_refs",
        "api_refs"
      ],
      "description": "構造化参照（G-SEMANTIC-REF/G-COLUMN-REF/G-STATE-EVIDENCE-CONSISTENCY が正本と突合）。自由文でなくこの配列が意味整合の検査対象。",
      "properties": {
        "table_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "参照テーブル（ddl.sql と突合）"
        },
        "column_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z_]+$"
          },
          "description": "<table>.<column>（ddl.sql と突合）"
        },
        "state_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z_]+$"
          },
          "description": "<entity>.<state>（transitions.json と突合）"
        },
        "event_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "遷移イベント（transitions.json と突合）"
        },
        "evidence_kind_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "evidence kind（evidence-kinds.json と突合）"
        },
        "error_type_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "エラー型（error-taxonomy と突合）"
        },
        "api_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "公開 API 名（du-contracts と突合）"
        }
      }
    },
    "verifies_clause_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^API-DU[0-9]{2}-[0-9]{2}-(PRE|POST|RAISE)-[0-9]{2}$"
      },
      "description": "この AC が検証する API 契約節（du-contracts の clause_id）。どの節を検証しているかを構造参照で示し、語彙一致で代替しない（G-L6-IMPLEMENTATION-TRACE）"
    },
    "api_observation_assertions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^API-DU[0-9]{2}-[0-9]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture", "action", "observation", "assert", "clause_refs"],
        "properties": {
          "fixture": {"type": "string", "minLength": 20},
          "action": {"type": "string", "minLength": 20},
          "observation": {"type": "string", "minLength": 20},
          "assert": {"type": "string", "minLength": 20},
          "clause_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^API-DU[0-9]{2}-[0-9]{2}-(PRE|POST|RAISE)-[0-9]{2}$"
            },
            "description": "この API 固有 assertion が実際に検証する同一 AC の契約節。verifies_clause_refs の部分集合でなければならない"
          }
        }
      },
      "description": "複数APIを束ねる既存ACへAPIを追加するときの、API固有かつ反証可能なfixture／呼出／観測／assert。節IDの追記だけで被覆を名乗ることを禁止する"
    },
    "clause_na_reason": {
      "type": "string",
      "minLength": 10,
      "description": "verifies_clause_refs が空である理由（API 契約節ではなく CI・ratchet・DDL 等を観測する AC）。空でないときは書けない"
    }
  }
}
