    },
    {
      "key": "comparison_axes",
      "text": "提示する比較軸"
    },
    {
      "key": "defined_value",
      "text": "定義する価値"
    },
    {
      "key": "target_hypothesis_ids",
      "text": "対象となる戦略仮説（VH-* / CA-*）"
    }
  ]
