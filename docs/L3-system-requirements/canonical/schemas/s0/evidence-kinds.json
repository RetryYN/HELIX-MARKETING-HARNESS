  "items": [
    {
      "kind": "plan_record",
      "value_semantics": "action plan ID",
      "required_payload_keys": ["plan_id", "appeal", "target", "intent"],
      "column_rules": "`plan_id` は `pair_plan_quality.plan_id` と整合"
    },
    {
      "kind": "commit_hash",
      "value_semantics": "commit hash",
      "required_payload_keys": ["repository", "commit_hash", "paths"],
      "column_rules": "`commit_hash` 列も同値。40 又は 64 桁 hash"
    },
    {
      "kind": "review_pass",
      "value_semantics": "review ID",
      "required_payload_keys": ["result", "checked_items", "commit_hash", "reviewer"],
      "column_rules": "`result = PASS`、`commit_hash` 列必須。`reviewer` は author と別 agent"
    },
    {
      "kind": "published_url",
      "value_semantics": "canonical URL",
      "required_payload_keys": ["url", "wp_post_id", "external_operation_id", "asset_id"],
      "column_rules": "`asset_id`、`external_operation_id` 列必須。URL は `assets.canonical_url` と整合"
    },
    {
      "kind": "measurement",
      "value_semantics": "source hash",
      "required_payload_keys": ["source", "file_hash", "period_start", "period_end", "row_count"],
      "column_rules": "`file_hash` 列必須。`measurements.evidence_id` が参照"
    },
    {
      "kind": "screenshot",
      "value_semantics": "file hash",
      "required_payload_keys": ["file_path", "file_hash", "captured_at"],
      "column_rules": "`file_path`・`file_hash` 列必須"
    },
    {
      "kind": "file_hash",
      "value_semantics": "file hash",
      "required_payload_keys": ["file_path", "file_hash", "algorithm"],
      "column_rules": "`algorithm = SHA-256`、両列必須"
    },
    {
      "kind": "approval",
      "value_semantics": "approval ID",
      "required_payload_keys": ["approval_id", "decision", "binding_subject", "binding_operation", "binding_at"],
      "column_rules": "`decision = approved`、`approvals.evidence_id` と相互整合"
    },
    {
      "kind": "operation_log",
      "value_semantics": "external operation ID",
      "required_payload_keys": ["service", "operation", "external_operation_id", "request_fingerprint", "result"],
      "column_rules": "`external_operation_id` 列必須。secret・本文・credential は禁止"
    },
    {
      "kind": "dashboard",
      "value_semantics": "output hash",
      "required_payload_keys": ["file_path", "file_hash", "period_end"],
      "column_rules": "`file_path`・`file_hash` 列必須"
    }
  ],
  "required_kinds_by_task_type": {
    "T-PLAN": ["plan_record"],
    "T-PROD": ["commit_hash"],
    "T-REVIEW": ["review_pass"],
    "T-PUB": ["published_url", "screenshot", "approval"],
    "T-MEAS": ["measurement", "file_hash", "screenshot"]
  },
  "completion_rule": "必須 kind は `workflows.required_evidence_json` に JSON 配列で宣言する。`done` 遷移では、現在の workflow の全 kind が当該 task に存在し、各 kind 規則を再検証してからのみ遷移する。"
}
