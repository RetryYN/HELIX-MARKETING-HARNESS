{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helix-marketing-harness/strategy/logic-tree.schema.json",
  "title": "logic_tree — 戦略仮説ロジックツリー（8 軸ノード語彙・因果背骨。KPI ツリー＝観測背骨と併存）",
  "type": "object",
  "required": ["id", "version", "strategic_choice_id", "nodes", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LT-"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "版。上書きせず新版を作る（append-only — SR-11 と同規律）"
    },
    "strategic_choice_id": {
      "type": "string",
      "pattern": "^SC-",
      "description": "このツリーが整理する戦略判断（SR-05）"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "node_kind", "statement", "parent_node_id", "model_refs", "metric_refs"],
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "node_kind": {
            "type": "string",
            "enum": [
              "segment",
              "target",
              "needs",
              "insight",
              "psychological_conversion",
              "behavioral_conversion",
              "situation",
              "literacy"
            ],
            "description": "整理軸 8 種のみ。positioning は演出軸（SR-19 の還流先）でありノード語彙に含めない"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "description": "ノードの仮説文（自由記述はここのみ。正当性は model_refs／metric_refs が担う）"
          },
          "parent_node_id": {
            "type": ["string", "null"],
            "description": "親ノード（root は null）。閉路禁止は受理側検査"
          },
          "model_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(SEG|VH|CA|SC|PM|MM)-"
            },
            "description": "意味モデル参照（segment_context／value_hypothesis／causal_assumption／strategic_choice／problem_model／market_model）。中間ノードは 1 件以上必須（受理側検査）"
          },
          "metric_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "KPI ツリー（観測背骨）上の観測指標参照。葉ノード（観測端点）は metric_refs のみでも可"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "superseded", "retired"]
    }
  }
}
