{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helix-marketing-harness/strategy/strategy-revision.schema.json",
  "title": "strategy_revision — 上流改善工程の出力。根拠・反証・信頼度・対象版を必須とし、単一計測値だけの自動 accept を拒否する",
  "type": "object",
  "required": [
    "id",
    "target_type",
    "target_id",
    "target_version",
    "revision_type",
    "reason",
    "supporting_evidence_ids",
    "counter_evidence_ids",
    "confidence",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SR(EV)?-"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "market_model",
        "segment_context",
        "problem_model",
        "value_hypothesis",
        "category_definition",
        "positioning_hypothesis",
        "causal_assumption",
        "strategic_choice",
        "strategic_brief"
      ]
    },
    "target_id": {
      "type": "string",
      "description": "対象正本 ID",
      "minLength": 1
    },
    "target_version": {
      "type": "integer",
      "minimum": 1,
      "description": "対象版（版を特定しない revision は無効）"
    },
    "revision_type": {
      "type": "string",
      "enum": [
        "maintain",
        "refine",
        "pivot",
        "reject",
        "retire"
      ]
    },
    "reason": {
      "type": "string",
      "description": "変更理由",
      "minLength": 8
    },
    "supporting_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(https?://|EV-|OBS-|TLP-|SREV-|file:)"
      },
      "description": "支持根拠（accepted には 2 件以上を要求 — 単一計測値だけの自動 accept 拒否）",
      "minItems": 1,
      "uniqueItems": true
    },
    "counter_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(https?://|EV-|OBS-|TLP-|SREV-|file:)"
      },
      "description": "反証（評価した反証がない accept は不可。反証ゼロ評価の場合も空配列を明示）",
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "信頼度（0.0〜1.0）。複数観測・反証の評価で更新する"
    },
    "affected_brief_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "new_version_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "生成した新版 ID。status=accepted かつ revision_type!=maintain では必須。新版の supersedes_id = target_id とし、revision accepted・新版 INSERT・旧版 status 遷移を単一 transaction で実行"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected"
      ]
    }
  },
  "additionalProperties": false
}
