{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helix-marketing-harness/strategy/inference-analysis.schema.json",
  "title": "inference_analysis — 統合データ分析成果物（手法非拘束・relationship_claim 3 水準・node_verdict）",
  "type": "object",
  "required": ["id", "version", "method", "input_series_digest", "claims", "node_verdicts", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^IA-"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "版。上書きせず新版を作る（append-only）"
    },
    "method": {
      "type": "object",
      "required": ["name", "model_version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "手法名（MMM／CausalImpact／DiD／実験等 — 固定しない。SR-19）"
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "prior_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "事前分布・事前学習の根拠参照（ベイズ手法の場合）"
        }
      }
    },
    "input_series_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "入力系列（計測事実・market_observation）の正準化 SHA-256。再現性の正本"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "claim_level", "cause", "effect", "uncertainty", "confounders_considered"],
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_level": {
            "type": "string",
            "enum": ["correlation", "spurious_candidate", "causal"],
            "description": "3 水準宣言必須。causal は confounders_considered 1 件以上（受理側検査）"
          },
          "cause": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "type": "string",
            "minLength": 1
          },
          "effect_estimate": {
            "type": "number",
            "description": "寄与・効果の点推定（単位は metric 側の定義に従う）"
          },
          "uncertainty": {
            "type": "object",
            "required": ["interval_low", "interval_high", "interval_kind"],
            "additionalProperties": false,
            "properties": {
              "interval_low": {
                "type": "number"
              },
              "interval_high": {
                "type": "number"
              },
              "interval_kind": {
                "type": "string",
                "minLength": 1,
                "description": "信用区間／信頼区間等の種別と水準（例: credible_0.9）"
              }
            }
          },
          "confounders_considered": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "検討した交絡・共変量。causal claim では空配列を拒否（SR-19）"
          }
        }
      }
    },
    "node_verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "verdict", "claim_ids", "evidence_refs"],
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1,
            "description": "突き当て先 logic_tree ノード（SR-18）"
          },
          "verdict": {
            "type": "string",
            "enum": ["supported", "refuted", "inconclusive"]
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "根拠 claim。correlation 水準のみで supported を宣言できない（受理側検査）"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "TLP・evidence への接続（SR-08／SR-18）。append-only"
          }
        }
      }
    },
    "positioning_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "statement", "claim_ids"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["strength", "weakness", "opportunity", "threat", "differentiation_candidate"],
            "description": "USP／SWOT 型の演出プラン入力（SR-19）。positioning_hypothesis への反映は strategy_revision 経由のみ"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "superseded", "retired"]
    }
  }
}
