{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helix-marketing-harness/strategy/tactical-learning-packet.schema.json",
  "title": "tactical_learning_packet — 下流→上流への唯一の還流契約。観測事実・解釈・因果・反証可能仮説・推奨判断を分離する",
  "type": "object",
  "required": [
    "id",
    "packet_kind",
    "loop_run_id",
    "strategic_brief_id",
    "strategic_brief_digest",
    "observations",
    "metrics",
    "confidence",
    "evidence_ids",
    "recommended_next_action"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TLP-"
    },
    "loop_run_id": {
      "type": "string",
      "description": "下流 loop run ID",
      "minLength": 1
    },
    "strategic_brief_id": {
      "type": "string",
      "pattern": "^SB-"
    },
    "strategic_brief_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "観測された事実（market_observation ID または事実文。解釈を混ぜない）",
      "minItems": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kpi_node_key",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "kpi_node_key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "period": {
            "type": "string"
          }
        }
      },
      "description": "計測値（KPI ツリー参照）。単一 KPI 変動だけで上流モデルを自動変更しない"
    },
    "qualitative_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hypothesis_assessment": {
      "type": "object",
      "required": [
        "result",
        "target_hypothesis_ids",
        "reason"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "supported",
            "weakened",
            "rejected",
            "inconclusive"
          ]
        },
        "target_hypothesis_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "判定対象の仮説 ID（VH-* / CA-* 等）",
          "minItems": 1
        },
        "reason": {
          "type": "string",
          "minLength": 8
        }
      },
      "description": "反証可能仮説の判定（観測・解釈とは別フィールド）"
    },
    "causal_interpretation": {
      "type": "string",
      "description": "AI による因果解釈（観測事実とは分離）",
      "minLength": 8
    },
    "alternative_explanations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "対立説明（単一解釈への固着を防ぐ）",
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "信頼度（0.0〜1.0）。複数観測・反証の評価で更新する"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(https?://|EV-|OBS-|TLP-|SREV-|file:)"
      },
      "description": "evidence への接続（G-LEARNING-TRACE）",
      "minItems": 1,
      "uniqueItems": true
    },
    "proposed_revision_targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "revision 提案対象（上流が評価する。下流は上流正本を直接更新できない）"
    },
    "recommended_next_action": {
      "type": "string",
      "enum": [
        "continue",
        "modify_tactic",
        "request_strategy_review",
        "stop"
      ]
    },
    "packet_kind": {
      "type": "string",
      "enum": [
        "learning",
        "failure"
      ],
      "description": "learning = 観測から学習を還流。failure = 観測前に失敗した run の事実還流（因果解釈の捏造禁止）"
    },
    "failure_fact": {
      "type": "string",
      "minLength": 1,
      "description": "failure packet 必須（学習 packet では持たない）"
    },
    "reproduction_conditions": {
      "type": "string",
      "minLength": 1,
      "description": "failure packet 必須（学習 packet では持たない）"
    },
    "recovery_conditions": {
      "type": "string",
      "minLength": 1,
      "description": "failure packet 必須（学習 packet では持たない）"
    }
  },
  "additionalProperties": false,
  "description": " packet_kind=learning は causal_interpretation・hypothesis_assessment 必須、packet_kind=failure は failure_fact・reproduction_conditions・recovery_conditions 必須で causal_interpretation を持てない（条件は validator/store が強制）。全終端下流 run は packet を 1 件持つ（UNIQUE(loop_run_id)）。"
}
