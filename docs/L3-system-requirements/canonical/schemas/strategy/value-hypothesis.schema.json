{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helix-marketing-harness/strategy/value-hypothesis.schema.json",
  "title": "value_hypothesis — 価値仮説（反証条件つき）",
  "type": "object",
  "required": [
    "id",
    "version",
    "segment_context_id",
    "problem_model_id",
    "current_loss",
    "desired_progress",
    "defined_value",
    "proof_mechanism",
    "differentiation_basis",
    "expected_recognition_change",
    "disconfirming_conditions",
    "evidence_ids",
    "confidence",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^VH-"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "版。上書きせず新版を作る（append-only）"
    },
    "segment_context_id": {
      "type": "string",
      "pattern": "^SEG-"
    },
    "problem_model_id": {
      "type": "string",
      "pattern": "^PRB-"
    },
    "current_loss": {
      "type": "string",
      "description": "現在の損失（放置コスト）",
      "minLength": 1
    },
    "desired_progress": {
      "type": "string",
      "description": "顧客が望む進歩",
      "minLength": 1
    },
    "defined_value": {
      "type": "string",
      "description": "定義する価値",
      "minLength": 1
    },
    "proof_mechanism": {
      "type": "string",
      "description": "価値の証明機構",
      "minLength": 1
    },
    "differentiation_basis": {
      "type": "string",
      "description": "差別化根拠",
      "minLength": 1
    },
    "expected_recognition_change": {
      "type": "string",
      "description": "期待する認識変化",
      "minLength": 1
    },
    "disconfirming_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "反証条件（これが観測されたら仮説を棄却/弱める）",
      "minItems": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(https?://|EV-|OBS-|TLP-|SREV-|file:)"
      },
      "description": "根拠 ID",
      "minItems": 1,
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "信頼度（0.0〜1.0）。複数観測・反証の評価で更新する"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "rejected",
        "retired"
      ]
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "置換した旧版の ID。上流正本の変更は supersedes_id による append-only 新バージョンのみ"
    }
  },
  "additionalProperties": false
}
