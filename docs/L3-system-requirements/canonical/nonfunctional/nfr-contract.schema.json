{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nfr-contract",
  "description": "非機能要件（NFR）の計測契約。測定対象・方法・閾値・環境・違反時動作・証跡を必須化する（全層再降下 §3）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "verification_aspects", "measurement_target", "measurement_method", "threshold", "measurement_env", "violation_behavior", "evidence", "trace_up", "trace_down", "semantic_refs"],
  "properties": {
    "id": {"type": "string", "pattern": "^NFR-[0-9]+$"},
    "title": {"type": "string", "minLength": 4},
    "verification_aspects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^NFR-[0-9]+:[a-z0-9-]+$"},
      "description": "measurement/threshold/violation の意味上の検証単位。専用 AC/TCC と集合完全一致させる"
    },
    "transition_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity", "from", "event", "to"],
        "properties": {
          "entity": {"type": "string", "enum": ["loop_runs", "tasks"]},
          "from": {"type": "string", "pattern": "^[a-z_]+$"},
          "event": {"type": "string", "pattern": "^[a-z_]+$"},
          "to": {"type": "string", "pattern": "^[a-z_]+$"}
        }
      },
      "description": "成立を要求する (entity, from, event, to)。transitions.json と完全照合し、専用 AC/TCC が同じ集合を被覆する"
    },
    "measurement_target": {"type": "string", "minLength": 10, "description": "測定対象（何の量・性質を測るか）"},
    "measurement_method": {"type": "string", "minLength": 15, "description": "測定方法（どのコマンド・クエリ・テストで測るか — 機械実行可能に）"},
    "threshold": {"type": "string", "minLength": 4, "description": "閾値（合否の数値・条件。config 値は config キー名で参照）"},
    "measurement_env": {"type": "string", "minLength": 6, "description": "測定環境（CI／ローカル／Docker WP 等）"},
    "violation_behavior": {"type": "string", "minLength": 15, "description": "違反時の動作（fail-close 先・escalation・停止）"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 6}},
    "trace_up": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 4}},
    "trace_down": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ac"],
      "properties": {
        "ac": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^AC-[0-9]+(-[0-9]+)?$"}},
        "tc": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
      }
    },
    "semantic_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_refs", "column_refs", "state_refs", "event_refs", "evidence_kind_refs", "error_type_refs", "api_refs"],
      "description": "構造化参照（G-SEMANTIC-REF/G-COLUMN-REF/G-STATE-EVIDENCE-CONSISTENCY が正本と突合）。",
      "properties": {
        "table_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "column_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$"}},
        "state_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$"}},
        "event_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "evidence_kind_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "error_type_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "api_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
