{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nfr-contract",
  "description": "非機能要件（NFR）の計測契約。測定対象・方法・閾値・環境・違反時動作・証跡を必須化する（全層再降下 §3）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "measurement_target", "measurement_method", "threshold", "measurement_env", "violation_behavior", "evidence", "trace_up", "trace_down"],
  "properties": {
    "id": {"type": "string", "pattern": "^NFR-[0-9]+$"},
    "title": {"type": "string", "minLength": 4},
    "measurement_target": {"type": "string", "minLength": 10, "description": "測定対象（何の量・性質を測るか）"},
    "measurement_method": {"type": "string", "minLength": 15, "description": "測定方法（どのコマンド・クエリ・テストで測るか — 機械実行可能に）"},
    "threshold": {"type": "string", "minLength": 4, "description": "閾値（合否の数値・条件。config 値は config キー名で参照）"},
    "measurement_env": {"type": "string", "minLength": 6, "description": "測定環境（CI／ローカル／Docker WP 等）"},
    "violation_behavior": {"type": "string", "minLength": 15, "description": "違反時の動作（fail-close 先・escalation・停止）"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 6}},
    "trace_up": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 4}},
    "trace_down": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ac"],
      "properties": {
        "ac": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^AC-[0-9]+(-[0-9]+)?$"}},
        "tc": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
      }
    }
  }
}
