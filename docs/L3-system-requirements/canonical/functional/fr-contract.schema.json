{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fr-contract",
  "description": "機能要件（FR）／戦略要件（SR）の実行契約。各要件に入出力・事前/事後/不変条件・正常/拒否/境界動作・復旧・冪等性・証跡・trace の 18 観点を必須化する（全層再降下 §3）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "input",
    "output",
    "precondition",
    "postcondition",
    "invariants",
    "state_transitions",
    "normal_behavior",
    "rejection_behavior",
    "boundary_behavior",
    "retry_resume_recovery",
    "human_judgement",
    "side_effects",
    "idempotency",
    "evidence",
    "tables",
    "external_deps",
    "config_values",
    "fixed_values",
    "trace_up",
    "trace_down",
    "slice",
    "semantic_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(FR-[0-9]+|SR-[0-9]{2})$"
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "input": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 6
      },
      "description": "入力（型・出所つき）"
    },
    "output": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 6
      },
      "description": "出力（型・行き先つき）"
    },
    "precondition": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "postcondition": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      },
      "description": "実行前後で破れない不変条件"
    },
    "state_transitions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 6
      },
      "description": "関与する状態遷移（(entity, from→to, event)。遷移なし = 空配列）"
    },
    "transition_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity", "from", "event", "to"],
        "properties": {
          "entity": {"type": "string", "enum": ["loop_runs", "tasks"]},
          "from": {"type": "string", "pattern": "^[a-z_]+$"},
          "event": {"type": "string", "pattern": "^[a-z_]+$"},
          "to": {"type": "string", "pattern": "^[a-z_]+$"}
        }
      },
      "description": "成立を要求する (entity, from, event, to)。transitions.json と完全照合し、対応AC/TCCが同じ集合を被覆する"
    },
    "normal_behavior": {
      "type": "string",
      "minLength": 20
    },
    "rejection_behavior": {
      "type": "string",
      "minLength": 20,
      "description": "拒否・異常動作（何を検知し、何を raise/記録し、どの状態へ倒すか）"
    },
    "boundary_behavior": {
      "type": "string",
      "minLength": 15,
      "description": "境界動作（上限・空・同時・期限切れ等の端の振る舞い）"
    },
    "retry_resume_recovery": {
      "type": "string",
      "minLength": 15,
      "description": "再試行・再開・復旧（クラッシュ後の再開点を含む）"
    },
    "human_judgement": {
      "type": "string",
      "minLength": 6,
      "description": "人間判断／escalation（なし = 『なし（全自動）』）"
    },
    "side_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 4
      },
      "description": "副作用（DB 書込み・外部呼出・ファイル生成。なし = ['なし（pure）']）"
    },
    "idempotency": {
      "type": "string",
      "minLength": 10,
      "description": "冪等性（再実行の安全性と重複検出方法）"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 6
      },
      "description": "残す証跡（evidence kind／operation_log）"
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "description": "使用テーブル・正本（読み書き別に r:/w: 接頭辞）"
    },
    "external_deps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "description": "外部依存（なし = 空配列）"
    },
    "config_values": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 4
      },
      "description": "config 行で保持する設定値（なし = 空配列）"
    },
    "fixed_values": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 4
      },
      "description": "固定値（設計固定の定数。なし = 空配列）"
    },
    "trace_up": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(BR-[A-Z][0-9]|BR-M-[A-Z0-9-]+|REQ-[0-9]{3}|NFR-[0-9]+|charter.*)$"
      }
    },
    "trace_down": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ac"
      ],
      "properties": {
        "ac": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^AC(-SR)?-[0-9]+(-[0-9]+)?$"
          },
          "description": "対応 AC（実装対象スライスでは非空必須 — G-AC-COVERAGE）"
        },
        "fn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FN-[0-9]+$"
          }
        },
        "cmp": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(CMP|SCM)-[0-9]{2}$"
          }
        }
      }
    },
    "slice": {
      "type": "string",
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3+"
      ],
      "description": "実装スライス（AC 必須判定・降下義務の基準）"
    },
    "design_status": {
      "type": "string",
      "enum": [
        "requirements_defined",
        "design_defined"
      ],
      "description": "L3 要求定義と L4+ 設計降下の境界。省略時は後方互換のため design_defined と扱う。requirements_defined は S1+ かつ FN/CMP 未接続の場合だけ許可。"
    },
    "ac_na": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "normal": {
          "type": "string",
          "minLength": 15
        },
        "reject": {
          "type": "string",
          "minLength": 15
        },
        "boundary-recovery": {
          "type": "string",
          "minLength": 15
        }
      },
      "description": "AC 極性のうち適用不能なものの理由付き N/A 宣言（G-AC-POLARITY が『AC 実在 or N/A 理由』を検査）"
    },
    "invariant_ac_map": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^AC(-SR)?-[0-9]+(-[0-9]+)?$"
        }
      },
      "description": "invariants[i] を負方向に検証する AC 群（S0 契約は invariants と同数必須 — G-INVARIANT-TRACE）"
    },
    "semantic_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_refs",
        "column_refs",
        "state_refs",
        "event_refs",
        "evidence_kind_refs",
        "error_type_refs",
        "api_refs"
      ],
      "description": "構造化参照（G-SEMANTIC-REF/G-COLUMN-REF/G-STATE-EVIDENCE-CONSISTENCY が正本と突合）。自由文でなくこの配列が意味整合の検査対象。",
      "properties": {
        "table_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "参照テーブル（ddl.sql と突合）"
        },
        "column_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z_]+$"
          },
          "description": "<table>.<column>（ddl.sql と突合）"
        },
        "state_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z_]+$"
          },
          "description": "<entity>.<state>（transitions.json と突合）"
        },
        "event_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "遷移イベント（transitions.json と突合）"
        },
        "evidence_kind_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "evidence kind（evidence-kinds.json と突合）"
        },
        "error_type_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "エラー型（error-taxonomy と突合）"
        },
        "api_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "公開 API 名（du-contracts と突合）"
        }
      }
    }
  }
}
